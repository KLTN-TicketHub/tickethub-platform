{
  "Identity": {
    "Authority": "https://localhost:7032",
    "Audience": "https://localhost:7044",
    "PublicKeyPath": "Keys/public.pem"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "AIInstance"
  },
  "GrpcSettings": {
    "CatalogUrl": "https://localhost:7170"
  },
  "OpenRouterAI": {
    "ApiKey": "<your-openrouter-api-key>",
    "BaseUrl": "https://openrouter.ai/api/v1/chat/completions",
    "Model": "openrouter/free",
    "MaxTokens": 2048,
    "Temperature": 0.7,
    "AutoApproveConfidenceThreshold": 85.0,
    "TimeoutSeconds": 30,
    "MaxRetries": 3
  },
  "AppSettings": {
    "RateLimit": {
      "AuthenticatedUser": {
        "PermitLimit": 200,
        "WindowMinutes": 1
      },
      "AnonymousUser": {
        "PermitLimit": 50,
        "WindowMinutes": 1
      },
      "LoginAttempts": {
        "PermitLimit": 5,
        "WindowMinutes": 15
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
