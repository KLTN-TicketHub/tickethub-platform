{
  "ConnectionStrings": {
    "PrimaryDbConnection": "Server=localhost;Database=TicketHub.Identity.Db;User Id=<db-user>;Password=<db-password>;TrustServerCertificate=True;Encrypt=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppSettings": {
    "JwtConfig": {
      "PrivateKeyPath": "Keys/private.pem",
      "PublicKeyPath": "Keys/public.pem",
      "KeyId": "key-1",
      "ValidAudience": "https://localhost:7044",
      "ValidIssuer": "https://localhost:7032",
      "TokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7
    },
    "RateLimit": {
      "AuthenticatedUser": {
        "PermitLimit": 200,
        "WindowMinutes": 1
      },
      "AnonymousUser": {
        "PermitLimit": 50,
        "WindowMinutes": 1
      },
      "LoginAttempts": {
        "PermitLimit": 20,
        "WindowMinutes": 15
      }
    }
  },
  "GoogleAuthSettings": {
    "ClientId": "<google-client-id>",
    "ClientSecret": "<google-client-secret>",
    "RedirectUri": "https://localhost:7044/api/v1/auth/google/callback"
  },
  "AppUrls": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "<rabbitmq-password>",
    "VirtualHost": "/"
  },
  "AdminAccount": {
    "Account": {
      "UserName": "admin",
      "Password": "<admin-password>",
      "FullName": "Admin User",
      "Email": "<admin-email>",
      "PhoneNumber": "<admin-phone>"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "tickethub-redis"
  },
  "AllowedHosts": "*"
}