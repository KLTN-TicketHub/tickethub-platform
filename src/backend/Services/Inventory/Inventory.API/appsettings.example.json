{
  "ConnectionStrings": {
    "PrimaryDbConnection": "Server=localhost;Database=TicketHub.Inventory.Db;User Id=<db-user>;Password=<db-password>;TrustServerCertificate=True;Encrypt=True"
  },
  "Identity": {
    "Authority": "https://localhost:7032",
    "Audience": "https://localhost:7044",
    "PublicKeyPath": "Keys/public.pem"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "InventoryInstance"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": "5672",
    "Username": "guest",
    "Password": "<rabbitmq-password>",
    "VirtualHost": "/"
  },
  "AppSettings": {
    "RateLimit": {
      "AuthenticatedUser": {
        "PermitLimit": 200,
        "WindowMinutes": 1
      },
      "AnonymousUser": {
        "PermitLimit": 50,
        "WindowMinutes": 1
      },
      "LoginAttempts": {
        "PermitLimit": 5,
        "WindowMinutes": 15
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
