{
  "ConnectionStrings": {
    "PrimaryDbConnection": "Server=localhost;Database=TicketHub.Payment.Db;User Id=<db-user>;Password=<db-password>;TrustServerCertificate=True;Encrypt=True"
  },
  "Identity": {
    "Authority": "https://localhost:7032",
    "Audience": "https://localhost:7044",
    "PublicKeyPath": "Keys/public.pem"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "PaymentInstance"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": "5672",
    "Username": "guest",
    "Password": "<rabbitmq-password>",
    "VirtualHost": "/"
  },
  "Payment": {
    "DefaultProvider": "VNPay",
    "VNPay": {
      "Version": "2.1.0",
      "Command": "pay",
      "TmnCode": "<your-tmn-code>",
      "HashSecret": "<your-hash-secret>",
      "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
      "RefundUrl": "https://sandbox.vnpayment.vn/merchant_webapi/api/transaction",
      "ReturnUrl": "https://localhost:7044/api/v1/payment/payments/vnpay-return",
      "IpnUrl": "https://localhost:7044/api/v1/payment/payments/vnpay-ipn",
      "Locale": "vn",
      "Currency": "VND",
      "TimeZoneId": "SE Asia Standard Time"
    }
  },
  "AppUrls": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "AppSettings": {
    "RateLimit": {
      "AuthenticatedUser": {
        "PermitLimit": 200,
        "WindowMinutes": 1
      },
      "AnonymousUser": {
        "PermitLimit": 50,
        "WindowMinutes": 1
      },
      "LoginAttempts": {
        "PermitLimit": 5,
        "WindowMinutes": 15
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
