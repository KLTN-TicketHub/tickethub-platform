# Domain thật đã trỏ DNS về VPS, dùng cho Caddy xin TLS Let's Encrypt và build-arg frontend
DOMAIN=tickethub.example.com

# Mật khẩu SA cho container SQL Server (dùng chung cho toàn bộ DB các service)
SA_PASSWORD=<sql-sa-password>

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<rabbitmq-password>

# Thư mục tuyệt đối trên VPS chứa appsettings.Production.json + Keys/*.pem thật của từng service
# (KHÔNG nằm trong repo git, tự tạo 1 lần trên VPS, copy từ appsettings.example.json rồi điền giá trị thật)
SECRETS_DIR=/opt/tickethub/secrets
