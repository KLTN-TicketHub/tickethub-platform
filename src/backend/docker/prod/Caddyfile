mq.{$DOMAIN} {
    reverse_proxy rabbitmq:15672
}

{$DOMAIN} {
    handle /api/* {
        reverse_proxy gateway:8080
    }

    handle /hubs/* {
        reverse_proxy gateway:8080
    }

    handle /uploads/events/* {
        reverse_proxy catalog-api:8080
    }

    handle /uploads/seatmaps/* {
        reverse_proxy catalog-api:8080
    }

    handle /uploads/moderators/* {
        reverse_proxy identity-api:8080
    }

    handle {
        reverse_proxy frontend:80
    }
}
